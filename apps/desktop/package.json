{
  "name": "@codex-monitor/desktop",
  "version": "0.3.1",
  "description": "Cross-platform Codex usage monitor and model verification workbench.",
  "author": {
    "name": "Codex Monitor contributors",
    "email": "cosmosmount@users.noreply.github.com"
  },
  "homepage": "https://github.com/CosmosMount/codex-monitor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CosmosMount/codex-monitor.git"
  },
  "desktopName": "com.codexmonitor.CodexMonitor.desktop",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --x64 --arm64 --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --x64 --arm64 --publish never"
  },
  "dependencies": {
    "@codex-monitor/core": "workspace:*",
    "@codex-monitor/hub": "workspace:*",
    "@codex-monitor/protocol": "workspace:*",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.codexmonitor.desktop",
    "productName": "Codex Monitor",
    "executableName": "codex-monitor",
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": ["out/**/*", "package.json"],
    "directories": { "output": "release" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "${productName}-Setup-${version}-windows-${arch}.${ext}" },
    "portable": { "artifactName": "${productName}-Portable-${version}-windows-${arch}.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "Codex Monitor contributors <cosmosmount@users.noreply.github.com>",
      "vendor": "Codex Monitor",
      "syncDesktopName": true
    }
  }
}
