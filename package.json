{
  "name": "codex-monitor",
  "version": "0.2.4",
  "private": true,
  "description": "Local-first multi-device Codex usage monitor and model verification workbench.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @codex-monitor/desktop dev",
    "dev:hub": "pnpm --filter @codex-monitor/hub dev",
    "agent": "pnpm --filter @codex-monitor/agent start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
